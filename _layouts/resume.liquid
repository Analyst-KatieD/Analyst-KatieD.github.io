--- 
layout: default 
--- 
<div class="post"> 
<header class="post-header"> 
<h1 class="post-title"> 
{{ page.title }} 
{% if page.resume_pdf %} 
<a 
{% if page.resume_pdf contains '://' %} 
href="{{ page.resume_pdf }}" 
{% else %} 
href="{{ page.resume_pdf | prepend: 'assets/pdf/' | relative_url }}" 
{% endif %} 
target="_blank" 
rel="noopener noreferrer" 
class="float-right" 
> 
<i class="fa-solid fa-file-pdf"></i> 
</a> 
{% endif %} 
</h1> 
{% if page.description %} 
<p class="post-description">{{ page.description }}</p> 
{% endif %} 
</header> 
<article>
  <div class="resume">

    {% for entry in site.data.resume %}

      {% if entry.title == "Professional Summary" %}
        {% comment %} <h3 class="card-title font-weight-medium">{{ entry.title }}</h3> {% endcomment %}
        <section class="resume-summary-card split-summary">
          <div class="summary-text">
            <p>{{ entry.contents }}</p>
          </div>
          <div class="summary-image">
            <img src="{{ '/assets/img/KatieD-high-res-32.jpg' | relative_url }}" alt="Profile photo">
          </div>
        </section>

      {% elsif entry.title == "Core Skills" %}
        <section class="resume-skills">
          <h3 class="card-title font-weight-medium">{{ entry.title }}</h3>
          <div class="skills-pill-container">
            {% for skill in entry.contents %}
              <span class="skill-pill">{{ skill }}</span>
            {% endfor %}
          </div>
        </section>

      {% else %}
        <a class="anchor" id="{{ entry.title }}"></a>
        <div class="card mt-3 p-3 resume-card">
          <h3 class="card-title font-weight-medium">{{ entry.title }}</h3>
          <div>
            {% if entry.type == 'list' %}
              {% include resume/list.liquid %}
            {% elsif entry.type == 'map' %}
              {% include resume/map.liquid %}
            {% elsif entry.type == 'nested_list' %}
              {% include resume/nested_list.liquid %}
            {% elsif entry.type == 'time_table' %}
              {% include resume/time_table.liquid %}
            {% elsif entry.type == 'list_groups' %}
              {% include resume/list_groups.liquid %}
            {% else %}
              {{ entry.contents }}
            {% endif %}
          </div>
        </div>

      {% endif %}

    {% endfor %}

  </div>
</article>

</div> 
