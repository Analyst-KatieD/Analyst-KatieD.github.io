<article>
  <div class="resume">

    {% for entry in site.data.resume %}

      {% if entry.title == "Professional Summary" %}
        <section class="resume-summary-card">
          <p>{{ entry.contents }}</p>
        </section>

      {% elsif entry.title == "Core Skills" %}
        <section class="resume-skills">
          <h3 class="card-title font-weight-medium">{{ entry.title }}</h3>
          <div class="skills-pill-container">
            {% for skill in entry.contents %}
              <span class="skill-pill">{{ skill }}</span>
            {% endfor %}
          </div>
        </section>

      {% else %}
        <a class="anchor" id="{{ entry.title }}"></a>
        <div class="card mt-3 p-3 resume-card">
          <h3 class="card-title font-weight-medium">{{ entry.title }}</h3>
          <div>
            {% if entry.type == 'list' %}
              {% include resume/list.liquid %}
            {% elsif entry.type == 'map' %}
              {% include resume/map.liquid %}
            {% elsif entry.type == 'nested_list' %}
              {% include resume/nested_list.liquid %}
            {% elsif entry.type == 'time_table' %}
              {% include resume/time_table.liquid %}
            {% elsif entry.type == 'list_groups' %}
              {% include resume/list_groups.liquid %}
            {% else %}
              {{ entry.contents }}
            {% endif %}
          </div>
        </div>

      {% endif %}

    {% endfor %}

  </div>
</article>
